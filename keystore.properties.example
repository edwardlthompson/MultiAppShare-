# Copy this file to keystore.properties in the repo root (gitignored).
# Paths are relative to the repository root unless you use an absolute path.
#
# Create a keystore once, then keep it and keystore.properties only on trusted machines:
#   keytool -genkeypair -v -keystore release.keystore -alias YOUR_ALIAS \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=release.keystore
storePassword=
keyAlias=
keyPassword=
